OIL_VERSION = "2.5";

/* App Trampoline dau tien tren Hiwonder V1.2 (ECU1, HSE 16 MHz).
 * 1 task blink dao LED PE10, duoc alarm blink_al kich hoat moi 500 tick
 * (SystemCounter = 1 tick/ms -> LED doi trang thai moi 500 ms). */

IMPLEMENTATION trampoline {
  TASK { UINT32 STACKSIZE = 512 ; } ;
  ISR  { UINT32 STACKSIZE = 256 ; } ;
};

CPU f407_blink {
  OS config {
    STATUS = EXTENDED;
    BUILD = TRUE {
      /* duong dan tuong doi: tests/target/f407_blink -> third_party/trampoline (submodule) */
      TRAMPOLINE_BASE_PATH = "../../../third_party/trampoline";
      APP_SRC = "f407_blink.c";
      APP_NAME = "f407_blink_exe";
      CFLAGS  = "-O2";
      LDFLAGS = "-Map=f407_blink.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  TASK blink {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  ALARM blink_al {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = blink; };
    AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 500; CYCLETIME = 500; };
  };
};
