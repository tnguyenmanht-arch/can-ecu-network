OIL_VERSION = "2.5";

/* Test bus that 2 board, phia NHAN: Hiwonder V1.2 (ECU1, HSE 16 MHz, APB1 42 MHz).
 * F103 gui 0x080 moi 100 ms -> FIFO0 -> ngat CAN1_RX0 -> ISR can_rx_isr doc + nha FIFO,
 * ActivateTask(Task_CanRx) -> Task_CanRx kiem so thu tu, dao LED PE10.
 * Alarm_Esr 100 tick -> Task_EsrCopy chep CAN1->ESR ra RAM. */

IMPLEMENTATION trampoline {
  TASK { UINT32 STACKSIZE = 512 ; } ;
  ISR  { UINT32 STACKSIZE = 256 ; } ;
};

CPU bus2_f407_rx {
  OS config {
    STATUS = EXTENDED;
    BUILD = TRUE {
      /* duong dan tuong doi: tests/target/bus2_f407_rx -> goc repo */
      TRAMPOLINE_BASE_PATH = "../../../third_party/trampoline";
      APP_SRC = "bus2_f407_rx.c";
      APP_SRC = "../../../drivers/bxcan/bxcan.c";
      APP_SRC = "../../../drivers/mcu/stm32f407/can_port_f407.c";
      APP_NAME = "bus2_f407_rx_exe";
      CFLAGS  = "-O2";
      /* bxcan.h + can_port.h ban F407 (chon chip bang include path) */
      CFLAGS  = "-I../../../drivers/bxcan";
      CFLAGS  = "-I../../../drivers/mcu/stm32f407";
      LDFLAGS = "-Map=bus2_f407_rx.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };

  APPMODE std {};

  TASK Task_EsrCopy {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  TASK Task_CanRx {
    PRIORITY = 2;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };

  ALARM Alarm_Esr {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = Task_EsrCopy; };
    AUTOSTART = TRUE { APPMODE = std; ALARMTIME = 100; CYCLETIME = 100; };
  };

  ISR can_rx_isr {
    CATEGORY = 2;
    PRIORITY = 1;
    SOURCE = CAN1_RX0_IRQ;
  };
};
